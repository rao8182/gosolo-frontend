# Database Connection
# For production, use Supabase pooled connection or your PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/database"

# Razorpay Payment Gateway
# Get your keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Next.js Public Variables (accessible in browser)
# Must start with NEXT_PUBLIC_ to be available in client-side code
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
